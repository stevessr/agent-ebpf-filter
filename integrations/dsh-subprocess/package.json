{
  "name": "@agent-ebpf/dsh-subprocess",
  "version": "0.1.0",
  "description": "DeepSeek Harness subprocess provider that routes every Harness-owned exec through Agent eBPF policy",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "src/*.js",
    "cordis.patch.yml"
  ],
  "license": "Apache-2.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-subprocess-local": ">=0.2.0-0 <0.3.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  }
}
