#!/bin/sh
# Agent eBPF Filter — Commit-msg hook
# Validates conventional commit format: type(scope): description

set -e

# Real ESC byte (not the literal text "\033"): /bin/sh may be bash, whose
# builtin echo does not expand backslash escapes without -e. printf always does.
ESC=$(printf '\033')
RED="${ESC}[0;31m"
GREEN="${ESC}[0;32m"
YELLOW="${ESC}[1;33m"
CYAN="${ESC}[0;36m"
NC="${ESC}[0m"

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="$2"

# Skip validation for merges, squashes, cherry-picks and reverts generated by git.
#
# $2 (COMMIT_SOURCE) is only set to "merge"/"squash" when GIT itself creates the
# commit. After a conflicted merge (or `git merge --no-commit`) the user has to
# run a bare `git commit`, where $2 is empty — so the message file still holds
# git's "Merge remote-tracking branch '...'" template and the check below would
# reject it. Detect those states from the git directory instead.
if [ "$COMMIT_SOURCE" = "merge" ] || [ "$COMMIT_SOURCE" = "squash" ]; then
    exit 0
fi

GIT_DIR=$(git rev-parse --git-dir 2>/dev/null || echo .git)
if [ -f "$GIT_DIR/MERGE_HEAD" ] || [ -f "$GIT_DIR/MERGE_MSG" ] || [ -f "$GIT_DIR/SQUASH_MSG" ]; then
    exit 0
fi

MSG=$(cat "$COMMIT_MSG_FILE")

# Allow blank/comment lines
echo "$MSG" | grep -vE '^($|#)' | head -1 > /dev/null || exit 0

FIRST_LINE=$(echo "$MSG" | grep -vE '^($|#)' | head -1)

# Allow git-generated revert continuations ("Revert \"...\"" / "Reapply \"...\""):
# git revert --continue re-creates these without --no-verify, but the hook
# contract only exempts merge/squash COMMIT_SOURCE values.
case "$FIRST_LINE" in
    'Revert "'* | 'Reapply "'*) exit 0 ;;
esac

# Pattern: type(scope): description
# type: feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert
# scope: alphanumeric, hyphens, slashes, underscores
# description: anything after ": "
PATTERN='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9_/.-]+\))?!?: .+$'

echo "$FIRST_LINE" | grep -qE "$PATTERN" && exit 0

# Give more specific feedback
echo ""
echo "${CYAN}━━━ Commit Message Validation ━━━${NC}"
echo "${RED}✗ Invalid commit message format${NC}"
echo ""
echo "  ${YELLOW}Expected:${NC} type(scope): description"
echo "  ${YELLOW}Got:${NC}      $FIRST_LINE"
echo ""
echo "  ${YELLOW}Types:${NC} feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
echo "  ${YELLOW}Scope:${NC} component/module (optional, e.g. backend, frontend, ebpf)"
echo "  ${YELLOW}Examples:${NC}"
echo "    feat(ebpf): add TLS handshake capture hook"
echo "    fix(backend): handle nil pointer in event dispatch"
echo "    docs: update API reference"
echo "    refactor(wrapper): simplify policy evaluation"
echo ""
echo "${YELLOW}  To bypass this check: git commit --no-verify (-n)${NC}"
echo "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

exit 1