#!/bin/sh
# Agent eBPF Filter — Pre-push hook
# Runs lint and test gates before allowing push.

set -e

# Real ESC byte (not the literal text "\033"): /bin/sh may be bash, whose
# builtin echo does not expand backslash escapes without -e. printf always does.
ESC=$(printf '\033')
RED="${ESC}[0;31m"
GREEN="${ESC}[0;32m"
YELLOW="${ESC}[1;33m"
CYAN="${ESC}[0;36m"
NC="${ESC}[0m"
echo ""
echo "${CYAN}━━━ Pre-push: Verification Gate ━━━${NC}"

REMOTE="$1"
URL="$2"

# Only check on branch pushes, not tag pushes or deletions.
# Push info arrives on stdin: <local-ref> SP <local-sha> SP <remote-ref> SP <remote-sha>
# ($3+ are NOT populated by git-push; reading them there always saw empty values
# and skipped the entire gate below).
LOCAL_REF=""
LOCAL_SHA=""
while IFS=' ' read -r lr lsha rr rsha; do
    [ -n "$lr" ] || continue
    case "$lr" in
        # only branch pushes; tags and deletions skip the gate
        refs/heads/*) LOCAL_REF="$lr"; LOCAL_SHA="$lsha" ;;
    esac
done
if [ -z "$LOCAL_SHA" ] || [ "$LOCAL_SHA" = "0000000000000000000000000000000000000000" ]; then
    exit 0
fi
echo "  ${YELLOW}Pushing $LOCAL_REF → $REMOTE ($URL)${NC}"

# ── 1. Lint backend ──────────────────────────────────────────────────────
echo "${YELLOW}  → Running Go fmt check...${NC}"
UNFORMATTED=$(cd backend && gofmt -l . 2>/dev/null || true)
if [ -n "$UNFORMATTED" ]; then
    echo "${RED}  ✗ Unformatted Go files:${NC}"
    for f in $UNFORMATTED; do echo "    - backend/$f"; done
    echo "  ${YELLOW}Run 'make lint-backend' to fix.${NC}"
    echo "${RED}✗ Push rejected${NC}"
    exit 1
fi
echo "${GREEN}    ✓ Go formatting OK${NC}"

# ── 2. Lint wrapper ──────────────────────────────────────────────────────
UNFORMATTED_WRAPPER=$(cd wrapper && gofmt -l . 2>/dev/null || true)
if [ -n "$UNFORMATTED_WRAPPER" ]; then
    echo "${RED}  ✗ Unformatted wrapper files:${NC}"
    for f in $UNFORMATTED_WRAPPER; do echo "    - wrapper/$f"; done
    echo "${RED}✗ Push rejected${NC}"
    exit 1
fi
echo "${GREEN}    ✓ Wrapper formatting OK${NC}"

# ── 3. Frontend lint (if prettier available) ──────────────────────────────
if command -v prettier >/dev/null 2>&1; then
    echo "${YELLOW}  → Checking frontend formatting...${NC}"
    cd frontend
    PRETTIER_ERR=0
    prettier --check "src/**/*.{vue,ts,js,css,json,md}" "index.html" 2>/dev/null || PRETTIER_ERR=1
    cd ..
    if [ "$PRETTIER_ERR" -ne 0 ]; then
        echo "${YELLOW}  ⚠ Frontend formatting issues found (non-blocking).${NC}"
        echo "    ${YELLOW}Run 'make lint-frontend' to fix.${NC}"
    else
        echo "${GREEN}    ✓ Frontend formatting OK${NC}"
    fi
fi

# ── 4. Go vet ─────────────────────────────────────────────────────────────
echo "${YELLOW}  → Running go vet...${NC}"
if ! (cd backend && go vet ./... 2>/dev/null); then
    echo "${RED}  ✗ Go vet found issues. Fix before pushing.${NC}"
    echo "${RED}✗ Push rejected${NC}"
    exit 1
fi
echo "${GREEN}    ✓ Go vet OK${NC}"

# ── 5. Build check ────────────────────────────────────────────────────────
echo "${YELLOW}  → Checking compilation...${NC}"
(cd backend && go build -o /dev/null . 2>/dev/null) || {
    echo "${RED}  ✗ Backend does not compile.${NC}"
    echo "${RED}✗ Push rejected${NC}"
    exit 1
}
(cd wrapper && go build -o /dev/null . 2>/dev/null) || {
    echo "${RED}  ✗ Wrapper does not compile.${NC}"
    echo "${RED}✗ Push rejected${NC}"
    exit 1
}
echo "${GREEN}    ✓ Compilation OK${NC}"

echo "${GREEN}━━━ Pre-push checks passed ━━━${NC}"
echo ""
