// Independent CI-only tracepoint reference for the eBPF openat soak.
// Capture only numeric PID counts. Never read argv, pathname, payload or keys.
// TASK_COMM_LEN is 16, so the file fixture's comm is truncated to 15 bytes.
BEGIN
{
    printf("[soak-syscall-trace] ready\n");
}

tracepoint:syscalls:sys_enter_openat
/comm == "soak-file-opena" || comm == "soak-file-probe"/
{
    @openat_enter[pid] = count();
}

tracepoint:syscalls:sys_exit_openat
/comm == "soak-file-opena" || comm == "soak-file-probe"/
{
    @openat_exit[pid] = count();
}

// Supply the architecture-specific openat syscall number as positional parameter $1.
// The raw syscall probes bypass the syscall-name-specific entry tracepoint,
// allowing a genuine missing named-enter observation to be distinguished
// from an incorrect comm gate or missing syscall. Keep all data numeric.
tracepoint:raw_syscalls:sys_enter
/args.id == $1 && (comm == "soak-file-opena" || comm == "soak-file-probe")/
{
    @raw_openat_enter[pid] = count();
}

tracepoint:raw_syscalls:sys_exit
/args.id == $1 && (comm == "soak-file-opena" || comm == "soak-file-probe")/
{
    @raw_openat_exit[pid] = count();
}
